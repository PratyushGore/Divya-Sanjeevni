# Django General Settings
SECRET_KEY=your-50-plus-character-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# JWT Settings
JWT_SECRET_KEY=your-jwt-secure-signing-key-here

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting Settings (Defaults to 100 requests per 60 seconds)
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW=60

# HTTPS and SSL Settings (Set to True in production)
ENFORCE_HTTPS=False
